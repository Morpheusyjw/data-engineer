# ============================================================
# 环境变量模板（复制为 .env 后填入你自己的值，.env 不要提交！）
# 用法：cp .env.example .env  然后编辑 .env
# ============================================================

# ---- Q4 LLM 抽取（OpenAI 兼容接口）----
# 没有 Key 时，extract_reviews.py 会自动降级为「规则方法」，仍能产出结果。
OPENAI_API_KEY=sk-你的key填这里
# 模型可选：gpt-4o-mini（便宜够用）、gpt-4o（更强更贵）
OPENAI_MODEL=gpt-4o-mini
# 兼容网关（可选）：若用第三方 OpenAI 兼容服务，填其 base_url；留空则用官方
OPENAI_BASE_URL=

# ---- Q2 MySQL 连接（run_q2.py 读取）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=olist
