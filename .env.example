# ============================================================
# 环境变量模板（复制为 .env 后填入你自己的值，.env 不要提交！）
# 用法：cp .env.example .env  然后编辑 .env
# ============================================================

# ---- Q4 LLM 抽取（OpenAI 兼容接口）----
# 留空 = 不调大模型，自动走「规则方法」，全流程照样跑完并产出 14,447 条结果。
# 想跑真实大模型再填自己的 key（下方占位符会被识别为「未填写」，不会误触发调用）。
OPENAI_API_KEY=
# 填写示例（取消注释后改成真的 key）：
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型可选：gpt-4o-mini（便宜够用）、gpt-4o（更强更贵）
OPENAI_MODEL=gpt-4o-mini
# 兼容网关（可选）：若用第三方 OpenAI 兼容服务（如硅基流动 SiliconFlow、DeepSeek），填其 base_url；留空则用官方
OPENAI_BASE_URL=

# ---- Q2 MySQL 连接（run_q2.py 读取）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=olist
